{
  "name": "mcp-hi-genie-orchestrator",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json && tsc -b tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright install chromium && playwright test tests/smoke.spec.ts",
    "clean": "rm -rf client/dist dist build node_modules .smoke-test test-results playwright-report",
    "migrate": "tsx ./server/migrations/migrate.ts",
    "postinstall": "npm run typegen || true",
    "prebuild": "npm run sync && npm run typegen || true",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": ["mcp", "orchestrator", "databricks", "appkit", "lakebase"],
  "author": "matthew.giglia@databricks.com",
  "license": "UNLICENSED",
  "description": "Hi Genie Orchestrator — Supervisor dispatch API and Workstream MCP powered by AppKit + Lakebase",
  "dependencies": {
    "@databricks/appkit": "0.89.0",
    "@databricks/appkit-ui": "0.89.0",
    "@mlflow/core": "0.4.0",
    "@databricks/sdk-experimental": "0.17.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/instrumentation": "0.219.0",
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "clsx": "2.1.1",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "swagger-ui-express": "^5.0.1",
    "@types/swagger-ui-express": "^4.1.7",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.546.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.13.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "uuid": "^11.1.0",
    "zod": "4.3.6",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "tailwindcss": "4.0.14",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
