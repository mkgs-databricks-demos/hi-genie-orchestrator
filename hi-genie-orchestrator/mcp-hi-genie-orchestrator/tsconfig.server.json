{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020"],
    "noEmit": true,
    "rootDir": "./"
  },
  "include": ["server/server.ts", "server/migrations/**/*", "server/telemetry/**/*", "server/memory/**/*", "server/dispatch/**/*", "server/mcp/**/*", "server/api/**/*", "server/services/**/*", "shared/**/*", "config/**/*"],
  "exclude": ["node_modules", "dist", "client", "**/*.test.ts"]
}
